<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest: LineageOS 17.1 (Android 10) untuk OPPO A37 / A37f / A37fw
  Chipset: Qualcomm MSM8916 (Snapdragon 410), codename LineageOS: A37

  Taruh di: .repo/local_manifests/A37.xml
-->
<manifest>
  <remote name="gh" fetch="https://github.com/" />

  <!-- Device tree.
       Dipilih karena set komponennya paling dekat dengan ROM 17.1 yang terbukti
       boot di perangkat: punya lights/ sendiri (bukan meminjam light HAL Lenovo
       a6000), wcnss_oppo/, service livedisplay, dan dependency timekeep. -->
  <project name="meghs-playground/rb_device_oppo_A37" path="device/oppo/A37"
           remote="gh" revision="rb" />

  <!-- Vendor blobs. Root repo berisi folder A37/, jadi path-nya vendor/oppo
       (BUKAN vendor/oppo/A37). A37-vendor.mk merujuk 328 file dan semuanya ada.
       Membawa prebuilt yang tidak punya sumber di tree: perf@1.0-service,
       iop@1.0/2.0, bluetooth@1.0-service-qti, drm widevine, time_daemon. -->
  <project name="meghs-playground/rb-vendor_oppo_A37" path="vendor/oppo"
           remote="gh" revision="lineage-17.1" />

  <!-- Kernel 3.10.108. Fork yang lebih baru daripada OPPO-A37/kernel_oppo_msm8939
       (head 2026-06 vs 2022-03), defconfig sama: lineageos_a37f_defconfig dengan
       CONFIG_ARCH_MSM8916=y + CONFIG_MACH_15399=y. -->
  <project name="meghs-playground/kernel_oppo_msm8939" path="kernel/oppo/msm8939"
           remote="gh" revision="0.0" clone-depth="1" />

  <!-- Dependency dari device/oppo/A37/lineage.dependencies -->
  <project name="LineageOS/android_hardware_sony_timekeep" path="hardware/sony/timekeep"
           remote="gh" revision="lineage-17.1" />

  <!-- Di-pin manual: LineageOS/android_external_stlport TIDAK punya branch
       lineage-17.1, roomservice akan gagal sync kalau dibiarkan. -->
  <project name="LineageOS/android_external_stlport" path="external/stlport"
           remote="gh" revision="lineage-15.1" />
</manifest>
