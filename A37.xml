<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest: LineageOS 17.1 (Android 10) untuk OPPO A37 / A37f / A37fw
  Chipset: Qualcomm MSM8916 (Snapdragon 410), codename LineageOS: A37

  Taruh di: .repo/local_manifests/A37.xml
-->
<manifest>
  <remote name="gh" fetch="https://github.com/" />

  <!-- Device tree -->
  <project name="yashraj22/device_oppo_A37" path="device/oppo/A37"
           remote="gh" revision="lineage-17.1" />

  <!-- Vendor blobs (Android 10). device.mk memanggil vendor/oppo/A37/A37-vendor.mk -->
  <project name="DeepakChaurasia30/android-vendor_oppo_A37" path="vendor/oppo/A37"
           remote="gh" revision="ten" />

  <!--
    Kernel 3.10.108. Nama repo "msm8939" menyesatkan: ini source drop gabungan
    OPPO msm8916/msm8939, dan lineageos_a37f_defconfig di dalamnya memakai
    CONFIG_ARCH_MSM8916=y + CONFIG_MACH_15399=y (nomor proyek OPPO A37).
    clone-depth=1 karena repo ini ~445k commit.
  -->
  <project name="OPPO-A37/kernel_oppo_msm8939" path="kernel/oppo/msm8939"
           remote="gh" revision="0.0" clone-depth="1" />

  <!--
    Dependency dari device/oppo/A37/lineage.dependencies.
    Di-pin manual ke lineage-15.1 karena LineageOS/android_external_stlport
    TIDAK punya branch lineage-17.1 (roomservice akan gagal sync kalau dibiarkan).
  -->
  <project name="LineageOS/android_external_stlport" path="external/stlport"
           remote="gh" revision="lineage-15.1" />
</manifest>
