@@ -167,7 +166,6 @@
 # GPS
 TARGET_NO_RPC := true
 USE_DEVICE_SPECIFIC_GPS := true
-SELINUX_IGNORE_NEVERALLOWS := true
 
 # Shim
 TARGET_LD_SHIM_LIBS := \
@@ -176,6 +174,9 @@
     /system/vendor/lib/hw/camera.vendor.msm8916.so|libshim_camera.so
 
 # SEpolicy
+# CATATAN: neverallow masih diabaikan karena file_contexts device ini belum
