diff --git a/include/linux/compiler.h b/include/linux/compiler.h
index 6977192b..27767737 100644
--- a/include/linux/compiler.h
+++ b/include/linux/compiler.h
@@ -370,4 +370,22 @@ void ftrace_likely_update(struct ftrace_branch_data *f, int val, int expect);
 #else
 # define __kprobes
 #endif
+
+/*
+ * Backport READ_ONCE()/WRITE_ONCE() dari kernel 3.19
+ * (commit 230fa253df63 "kernel: Provide READ_ONCE and ASSIGN_ONCE").
+ *
+ * Kernel 3.10 hanya punya ACCESS_ONCE(). ReSukiSU memakai READ_ONCE dan
+ * menyediakan definisi kompatibilitasnya sendiri di compat/kernel_compat.h,
+ * tapi sulog/fd.c memakainya tanpa meng-include header itu sehingga link gagal:
+ *   drivers/built-in.o: undefined reference to `READ_ONCE'
+ */
+#ifndef READ_ONCE
+#define READ_ONCE(x) (*(const volatile typeof(x) *)&(x))
+#endif
+
+#ifndef WRITE_ONCE
+#define WRITE_ONCE(x, val) ({ *(volatile typeof(x) *)&(x) = (val); (val); })
+#endif
+
 #endif /* __LINUX_COMPILER_H */
